{
  "name": "nmokey-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "sync": "node scripts/sync-site.mjs",
    "drafts": "node scripts/sync-site.mjs --drafts",
    "stamp": "uvx --from opentimestamps-client ots stamp",
    "check": "node scripts/sync-site.mjs --check && node scripts/check-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "html-validate": "11.16.0",
    "jsdom": "30.1.1",
    "marked": "18.0.14",
    "temml": "0.13.5"
  }
}
